# Points at the Postgres in docker-compose.yml.
# Any Postgres works — a Supabase or Neon connection string can be dropped in
# here, because all database access is raw SQL over `pg`. One caveat: the pool
# sets no `ssl` option, so append `?sslmode=require` to a hosted connection
# string.
DATABASE_URL=postgres://ottodot:ottodot@localhost:5434/ottodot
